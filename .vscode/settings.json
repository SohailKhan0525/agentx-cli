{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.exclude": {
    "**/.git": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/node_modules": false
  },
  "json.schemas": [
    {
      "fileMatch": ["agentx.json"],
      "url": "./packages/agentx-cli/src/config/schema.json"
    }
  ]
}
