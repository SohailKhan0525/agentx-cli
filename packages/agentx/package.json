{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@agent-qofeno/agentx-cli",
  "version": "2.0.5",
  "type": "module",
  "description": "The AI agent that builds production-ready websites from your terminal",
  "bin": {
    "agentx": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node script/build.js",
    "dev": "npm run build -- --watch",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SohailKhan0525/agentx-cli.git"
  },
  "homepage": "https://github.com/SohailKhan0525/agentx-cli",
  "bugs": {
    "url": "https://github.com/SohailKhan0525/agentx-cli/issues"
  },
  "author": "SohailKhan0525",
  "keywords": [
    "ai",
    "cli",
    "agent",
    "website-builder",
    "terminal",
    "nextjs",
    "ollama"
  ],
  "license": "MIT",
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.node.ts"
    },
    "#pty": {
      "node": "./src/pty/pty.node.ts",
      "default": "./src/pty/pty.node.ts"
    },
    "#hono": {
      "node": "./src/server/adapter.node.ts",
      "default": "./src/server/adapter.node.ts"
    }
  },
