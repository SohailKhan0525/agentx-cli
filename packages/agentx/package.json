    "@types/cross-spawn": "6.0.6",
    "@types/mime-types": "3.0.1",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.5.8",
    "@types/turndown": "5.0.5",
    "@types/which": "3.0.4",
    "@types/yargs": "17.0.33",
