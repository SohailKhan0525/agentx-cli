{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@agent-qofeno/agentx-cli",
  "version": "2.0.9",
  "description": "The AI agent that builds production-ready websites from your terminal",
  "bin": {
    "agentx": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "npm run --prefix packages/agentx build && node -e \"const fs=require('fs'); if(!fs.existsSync('dist')) fs.mkdirSync('dist'); fs.copyFileSync('packages/agentx/dist/index.js', 'dist/index.js'); if(fs.existsSync('packages/agentx/dist/yoga.wasm')) fs.copyFileSync('packages/agentx/dist/yoga.wasm', 'dist/yoga.wasm'); if(fs.existsSync('packages/agentx/dist/index.d.ts')) fs.copyFileSync('packages/agentx/dist/index.d.ts', 'dist/index.d.ts');\"",
    "prepublishOnly": "npm run build",
    "dev": "node packages/agentx/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node packages/agentx/dist/index.js --version"
  },
  "workspaces": [
    "packages/agentx",
    "packages/plugin",
    "packages/script",
    "packages/sdk/js",
    "packages/util"
  ],
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@types/mime-types": "3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "eslint": "^10.9.0",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "sst": "3.18.10",
    "turbo": "2.8.13",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "heap-snapshot-toolkit": "1.1.3",
    "typescript": "5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SohailKhan0525/agentx"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ]
}
